<!DOCTYPE html>
<html lang="gu">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Admin Login - Priyal Industry</title>
<link rel="stylesheet" href="/styles.css" />
<link rel="icon" type="image/jpeg" href="/images/logo.jpg?v=2" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Noto+Sans+Gujarati:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
<div class="container" style="max-width:420px;padding-top:80px">
  <form class="form" method="POST" action="/admin/login">
    <h2>Admin Login</h2>
    <p class="muted">Priyal Industry — owners only</p>
    <% if (error) { %><p class="err" role="alert"><%= error %></p><% } %>
    <label>Password<input type="password" name="password" required placeholder="Admin password" autocomplete="current-password" /></label>
    <button class="btn btn-primary btn-full" type="submit">Login</button>
    <p style="margin-top:12px"><a href="/">← Back to website</a></p>
  </form>
</div>
</body>
</html>
